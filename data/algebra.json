   "type": "mc",
   "topic": "algebra",
   "difficulty": 1,
   "stem": "If 3x − 7 = 11, what is x?",
   "choices": [
    "4/3",
    "6",
    "10",
    "18"
   ],
   "answer": 1,
   "hint": "Primero suma 7 en ambos lados.",
   "explanation": "3x = 18, así que x = 6.",
   "whyWrong": [
    "4/3 sale de restar 7 en vez de sumar (3x = 4).",
    null,
    "10 no resulta de ningún paso válido.",
    "18 es el valor de 3x, no de x."
   ]
  },
